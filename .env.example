# ============================================
# ComposeYogi — Environment Variables
# ============================================
#
# Every variable here is OPTIONAL. With none of them set, ComposeYogi runs
# exactly as it does in production: fully local-first, everything stored in
# your browser, nothing sent anywhere. That is a guarantee, not a default.
#
# Copy to `.env.local` and fill in only what you want.
#   cp .env.example .env.local


# --------------------------------------------
# Analytics (optional)
# --------------------------------------------
# Privacy-first, cookie-free, and self-hostable. No personal data, no
# cross-site tracking, nothing that needs a consent banner. Pick one.

# Plausible — https://plausible.io (or your own instance)
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=composeyogi.com
# NEXT_PUBLIC_PLAUSIBLE_HOST=https://plausible.io

# Umami — https://umami.is (self-hosted or cloud)
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# NEXT_PUBLIC_UMAMI_HOST=


# --------------------------------------------
# Sharing backend (not yet implemented — v1.5)
# --------------------------------------------
# Sharing will be powered by a managed, open-source backend configured entirely
# through these keys: paste them in and it runs, with no infrastructure to
# deploy. Leave them unset and the sharing UI is simply hidden.
#
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
